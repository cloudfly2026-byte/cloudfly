{
    "name": "chat-socket-service",
    "version": "1.0.0",
    "description": "Socket.IO microservice for real-time chat in Cloudfly",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "test": "jest --verbose --forceExit",
        "test:handlers": "jest src/handlers/__tests__/marketingHandler.test.js --verbose --forceExit",
        "test:routes": "jest src/routes/__tests__/marketing.test.js --verbose --forceExit"
    },
    "keywords": [
        "socket.io",
        "chat",
        "websocket",
        "real-time"
    ],
    "author": "Cloudfly Team",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.5",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "ioredis": "^5.3.2",
        "jsonwebtoken": "^9.0.2",
        "kafkajs": "^2.2.4",
        "mysql2": "^3.21.0",
        "socket.io": "^4.6.1",
        "socket.io-client": "^4.8.3",
        "uuid": "^9.0.0",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "nodemon": "^3.0.2",
        "supertest": "^7.2.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.test.js"
        ],
        "moduleDirectories": [
            "node_modules",
            "src"
        ]
    }
}
